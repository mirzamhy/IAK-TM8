  <notepads>
    <notepad>
      <note>LEVEL 3 - fact_manufaktur. Insert/Update per (sk_wilayah, sk_waktu, sk_skala):
baris baru di-insert, nilai yang berubah di-update, dijalankan ulang tidak dobel.</note>
      <xloc>40</xloc><yloc>20</yloc><width>520</width><heigth>40</heigth>
      <fontname/><fontsize>-1</fontsize><fontbold>N</fontbold><fontitalic>N</fontitalic>
      <fontcolorred>0</fontcolorred><fontcolorgreen>0</fontcolorgreen><fontcolorblue>0</fontcolorblue>
      <backgroundcolorred>210</backgroundcolorred><backgroundcolorgreen>245</backgroundcolorgreen><backgroundcolorblue>210</backgroundcolorblue>
      <bordercolorred>100</bordercolorred><bordercolorgreen>100</bordercolorgreen><bordercolorblue>100</bordercolorblue>
      <drawshadow>N</drawshadow>
    </notepad>
  </notepads>
  <order>
    <hop><from>tabel staging</from><to>sk_wilayah</to><enabled>Y</enabled></hop>
    <hop><from>dim wilayah</from><to>sk_wilayah</to><enabled>Y</enabled></hop>
    <hop><from>sk_wilayah</from><to>sk_waktu</to><enabled>Y</enabled></hop>
    <hop><from>dim waktu</from><to>sk_waktu</to><enabled>Y</enabled></hop>
    <hop><from>sk_waktu</from><to>sk_skala</to><enabled>Y</enabled></hop>
    <hop><from>dim skala</from><to>sk_skala</to><enabled>Y</enabled></hop>
    <hop><from>sk_skala</from><to>Calculator</to><enabled>Y</enabled></hop>
    <hop><from>Calculator</from><to>atur kolom</to><enabled>Y</enabled></hop>
    <hop><from>atur kolom</from><to>tabel fact manufaktur</to><enabled>Y</enabled></hop>
  </order>

  <step>
    <name>tabel staging</name>
    <type>TableInput</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning><method>none</method><schema_name/></partitioning>
    <connection>sqlite_manufaktur</connection>
    <sql>SELECT provinsi, tahun, skala, jumlah_perusahaan, tenaga_kerja, nilai_input_juta_rupiah, nilai_output_juta_rupiah, pengeluaran_tenaga_kerja_juta_rupiah
FROM stg_manufaktur</sql>
    <limit>0</limit>
    <lookup/>
    <execute_each_row>N</execute_each_row>
    <variables_active>Y</variables_active>
    <lazy_conversion_active>N</lazy_conversion_active>
    <attributes/>
    <cluster_schema/>
    <remotesteps><input></input><output></output></remotesteps>
    <GUI><xloc>80</xloc><yloc>260</yloc><draw>Y</draw></GUI>
  </step>
  <step>
    <name>dim wilayah</name>
    <type>TableInput</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning><method>none</method><schema_name/></partitioning>
    <connection>sqlite_manufaktur</connection>
    <sql>SELECT sk_wilayah, provinsi FROM dim_wilayah</sql>
    <limit>0</limit>
    <lookup/>
    <execute_each_row>N</execute_each_row>
    <variables_active>Y</variables_active>
    <lazy_conversion_active>N</lazy_conversion_active>
    <attributes/>
    <cluster_schema/>
    <remotesteps><input></input><output></output></remotesteps>
    <GUI><xloc>260</xloc><yloc>120</yloc><draw>Y</draw></GUI>
  </step>
  <step>
    <name>sk_wilayah</name>
    <type>StreamLookup</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning><method>none</method><schema_name/></partitioning>
    <from>dim wilayah</from>
    <input_sorted>N</input_sorted>
    <preserve_memory>Y</preserve_memory>
    <sorted_list>N</sorted_list>
    <integer_pair>N</integer_pair>
    <lookup>
      <key><name>provinsi</name><field>provinsi</field></key>
      <value><name>sk_wilayah</name><rename>sk_wilayah</rename><default/><type>Integer</type></value>
    </lookup>
    <attributes/>
    <cluster_schema/>
    <remotesteps><input></input><output></output></remotesteps>
    <GUI><xloc>260</xloc><yloc>260</yloc><draw>Y</draw></GUI>
  </step>
  <step>
    <name>dim waktu</name>
    <type>TableInput</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning><method>none</method><schema_name/></partitioning>
    <connection>sqlite_manufaktur</connection>
    <sql>SELECT sk_waktu, tahun FROM dim_waktu</sql>
    <limit>0</limit>
    <lookup/>
    <execute_each_row>N</execute_each_row>
    <variables_active>Y</variables_active>
