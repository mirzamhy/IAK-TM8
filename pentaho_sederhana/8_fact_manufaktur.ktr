    <GUI><xloc>580</xloc><yloc>120</yloc><draw>Y</draw></GUI>
  </step>
  <step>
    <name>sk_skala</name>
    <type>StreamLookup</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning><method>none</method><schema_name/></partitioning>
    <from>dim skala</from>
    <input_sorted>N</input_sorted>
    <preserve_memory>Y</preserve_memory>
    <sorted_list>N</sorted_list>
    <integer_pair>N</integer_pair>
    <lookup>
      <key><name>skala</name><field>skala</field></key>
      <value><name>sk_skala</name><rename>sk_skala</rename><default/><type>Integer</type></value>
    </lookup>
    <attributes/>
    <cluster_schema/>
    <remotesteps><input></input><output></output></remotesteps>
    <GUI><xloc>580</xloc><yloc>260</yloc><draw>Y</draw></GUI>
  </step>
  <step>
    <name>Calculator</name>
    <type>Calculator</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning><method>none</method><schema_name/></partitioning>
    <calculation>
      <field_name>nilai_tambah_juta_rupiah</field_name><calc_type>SUBTRACT</calc_type><field_a>nilai_output_juta_rupiah</field_a><field_b>nilai_input_juta_rupiah</field_b><field_c/>
      <value_type>Integer</value_type><value_length>15</value_length><value_precision>0</value_precision>
      <remove>N</remove><conversion_mask/><decimal_symbol/><grouping_symbol/><currency_symbol/>
    </calculation>
    <attributes/>
    <cluster_schema/>
    <remotesteps><input></input><output></output></remotesteps>
    <GUI><xloc>740</xloc><yloc>260</yloc><draw>Y</draw></GUI>
  </step>
  <step>
    <name>atur kolom</name>
    <type>SelectValues</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning><method>none</method><schema_name/></partitioning>
    <fields>
      <field><name>sk_wilayah</name><rename></rename><length>-2</length><precision>-2</precision></field>
      <field><name>sk_waktu</name><rename></rename><length>-2</length><precision>-2</precision></field>
      <field><name>sk_skala</name><rename></rename><length>-2</length><precision>-2</precision></field>
      <field><name>jumlah_perusahaan</name><rename></rename><length>-2</length><precision>-2</precision></field>
      <field><name>tenaga_kerja</name><rename></rename><length>-2</length><precision>-2</precision></field>
      <field><name>nilai_input_juta_rupiah</name><rename></rename><length>-2</length><precision>-2</precision></field>
      <field><name>nilai_output_juta_rupiah</name><rename></rename><length>-2</length><precision>-2</precision></field>
      <field><name>pengeluaran_tenaga_kerja_juta_rupiah</name><rename></rename><length>-2</length><precision>-2</precision></field>
      <field><name>nilai_tambah_juta_rupiah</name><rename></rename><length>-2</length><precision>-2</precision></field>
      <select_unspecified>N</select_unspecified>
    </fields>
    <attributes/>
    <cluster_schema/>
    <remotesteps><input></input><output></output></remotesteps>
    <GUI><xloc>740</xloc><yloc>400</yloc><draw>Y</draw></GUI>
  </step>
  <step>
    <name>tabel fact manufaktur</name>
    <type>InsertUpdate</type>
    <description/>
    <distribute>Y</distribute>
