  <step>
    <name>Ambil dataset_id &amp; tahun dari nama file</name>
    <type>RegexEval</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning><method>none</method><schema_name/></partitioning>
    <script><![CDATA[.*[\\/](\d{3})_[a-z_]+_(\d{4})\.(?:csv|xlsx|json)]]></script>
    <matcher>nama_file</matcher>
    <resultfieldname>nama_file_cocok</resultfieldname>
    <usevar>N</usevar>
    <allowcapturegroups>Y</allowcapturegroups>
    <replacefields>N</replacefields>
    <canoneq>N</canoneq><caseinsensitive>Y</caseinsensitive><comment>N</comment><dotall>N</dotall>
    <multiline>N</multiline><unicode>N</unicode><unix>N</unix>
