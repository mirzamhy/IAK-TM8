      <name>${Internal.Transformation.Filename.Directory}/../data_manufaktur_bps_2021_2025/raw_json</name>
      <filemask>442_.*\.json</filemask>
      <exclude_filemask/>
      <file_required>Y</file_required>
      <include_subfolders>N</include_subfolders>
    </file>
    <fields>
      <field>
        <name>provinsi</name>
        <path>$.records[*].provinsi</path>
        <type>String</type>
        <format/><currency/><decimal/><group/>
        <length>-1</length><precision>-1</precision>
        <trim_type>both</trim_type>
        <repeat>N</repeat>
      </field>
      <field>
        <name>mikro</name>
        <path>$.records[*].mikro_source_text</path>
        <type>String</type>
        <format/><currency/><decimal/><group/>
        <length>-1</length><precision>-1</precision>
        <trim_type>both</trim_type>
        <repeat>N</repeat>
      </field>
      <field>
        <name>kecil</name>
        <path>$.records[*].kecil_source_text</path>
        <type>String</type>
        <format/><currency/><decimal/><group/>
        <length>-1</length><precision>-1</precision>
        <trim_type>both</trim_type>
        <repeat>N</repeat>
      </field>
    </fields>
    <limit>0</limit>
    <IsInFields>N</IsInFields>
    <IsAFile>N</IsAFile>
    <valueField/>
    <shortFileFieldName/><pathFieldName/><hiddenFieldName/><lastModificationTimeFieldName/>
    <uriNameFieldName/><rootUriNameFieldName/><extensionFieldName/><sizeFieldName/>
    <attributes/>
    <cluster_schema/>
    <remotesteps><input></input><output></output></remotesteps>
