    <is_key_private>N</is_key_private>
  </info>
  <connection>
    <name>sqlite_manufaktur</name>
    <server/>
    <type>SQLITE</type>
    <access>Native</access>
    <database>${Internal.Transformation.Filename.Directory}/data/manufaktur_pentaho.sqlite</database>
    <port>-1</port>
    <username/>
    <password>Encrypted </password>
    <servername/>
    <data_tablespace/>
    <index_tablespace/>
    <attributes>
      <attribute><code>FORCE_IDENTIFIERS_TO_LOWERCASE</code><attribute>N</attribute></attribute>
      <attribute><code>FORCE_IDENTIFIERS_TO_UPPERCASE</code><attribute>N</attribute></attribute>
      <attribute><code>IS_CLUSTERED</code><attribute>N</attribute></attribute>
      <attribute><code>PORT_NUMBER</code><attribute>-1</attribute></attribute>
      <attribute><code>QUOTE_ALL_FIELDS</code><attribute>N</attribute></attribute>
      <attribute><code>SUPPORTS_BOOLEAN_DATA_TYPE</code><attribute>N</attribute></attribute>
      <attribute><code>USE_POOLING</code><attribute>N</attribute></attribute>
    </attributes>
  </connection>

  <notepads>
    <notepad>
      <note>LEVEL 3 - dimensi wilayah. Kode BPS menjadi primary key sehingga nama provinsi
yang berbeda antar-format tetap merujuk ke wilayah yang sama.</note>
      <xloc>60</xloc><yloc>30</yloc><width>480</width><heigth>40</heigth>
      <fontname/><fontsize>-1</fontsize><fontbold>N</fontbold><fontitalic>N</fontitalic>
      <fontcolorred>0</fontcolorred><fontcolorgreen>0</fontcolorgreen><fontcolorblue>0</fontcolorblue>
      <backgroundcolorred>210</backgroundcolorred><backgroundcolorgreen>245</backgroundcolorgreen><backgroundcolorblue>210</backgroundcolorblue>
      <bordercolorred>100</bordercolorred><bordercolorgreen>100</bordercolorgreen><bordercolorblue>100</bordercolorblue>
      <drawshadow>N</drawshadow>
    </notepad>
  </notepads>
  <order>
    <hop><from>wilayah.json</from><to>Boolean ke 0/1</to><enabled>Y</enabled></hop>
    <hop><from>Boolean ke 0/1</from><to>dim_wilayah (insert/update)</to><enabled>Y</enabled></hop>
  </order>

  <step>
    <name>wilayah.json</name>
    <type>JsonInput</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning><method>none</method><schema_name/></partitioning>
    <include>N</include>
    <include_field></include_field>
    <rownum>N</rownum>
    <addresultfile>N</addresultfile>
    <readurl>N</readurl>
    <removeSourceField>N</removeSourceField>
    <IsIgnoreEmptyFile>N</IsIgnoreEmptyFile>
    <doNotFailIfNoFile>N</doNotFailIfNoFile>
    <ignoreMissingPath>N</ignoreMissingPath>
    <defaultPathLeafToNull>Y</defaultPathLeafToNull>
    <rownum_field/>
    <file>
      <name>${Internal.Transformation.Filename.Directory}/../etl/config_2021_2025/wilayah.json</name>
      <filemask></filemask>
      <exclude_filemask/>
      <file_required>Y</file_required>
      <include_subfolders>N</include_subfolders>
    </file>
    <fields>
      <field>
        <name>kode_wilayah_bps</name>
        <path>$.regions[*].code</path>
        <type>String</type>
        <format/><currency/><decimal/><group/>
        <length>-1</length><precision>-1</precision>
        <trim_type>both</trim_type>
        <repeat>N</repeat>
      </field>
      <field>
        <name>provinsi</name>
        <path>$.regions[*].name</path>
        <type>String</type>
        <format/><currency/><decimal/><group/>
        <length>-1</length><precision>-1</precision>
        <trim_type>both</trim_type>
        <repeat>N</repeat>
      </field>
      <field>
        <name>is_nasional_teks</name>
        <path>$.regions[*].is_nasional</path>
        <type>String</type>
        <format/><currency/><decimal/><group/>
        <length>-1</length><precision>-1</precision>
        <trim_type>both</trim_type>
        <repeat>N</repeat>
      </field>
    </fields>
    <limit>0</limit>
    <IsInFields>N</IsInFields>
    <IsAFile>N</IsAFile>
    <valueField/>
    <shortFileFieldName/><pathFieldName/><hiddenFieldName/><lastModificationTimeFieldName/>
    <uriNameFieldName/><rootUriNameFieldName/><extensionFieldName/><sizeFieldName/>
    <attributes/>
    <cluster_schema/>
    <remotesteps><input></input><output></output></remotesteps>
    <GUI><xloc>80</xloc><yloc>120</yloc><draw>Y</draw></GUI>
  </step>
  <step>
    <name>Boolean ke 0/1</name>
    <type>ValueMapper</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning><method>none</method><schema_name/></partitioning>
    <field_to_use>is_nasional_teks</field_to_use>
    <target_field>is_nasional</target_field>
    <non_match_default>0</non_match_default>
    <fields>
      <field><source_value>true</source_value><target_value>1</target_value></field>
      <field><source_value>false</source_value><target_value>0</target_value></field>
    </fields>
    <attributes/>
    <cluster_schema/>
    <remotesteps><input></input><output></output></remotesteps>
    <GUI><xloc>260</xloc><yloc>120</yloc><draw>Y</draw></GUI>
  </step>
  <step>
    <name>dim_wilayah (insert/update)</name>
    <type>InsertUpdate</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning><method>none</method><schema_name/></partitioning>
    <connection>sqlite_manufaktur</connection>
    <commit>1000</commit>
    <update_bypassed>N</update_bypassed>
    <lookup>
      <schema/>
      <table>dim_wilayah</table>
      <key><name>kode_wilayah_bps</name><field>kode_wilayah_bps</field><condition>=</condition><name2/></key>
      <value><name>kode_wilayah_bps</name><rename>kode_wilayah_bps</rename><update>Y</update></value>
      <value><name>provinsi</name><rename>provinsi</rename><update>Y</update></value>
      <value><name>is_nasional</name><rename>is_nasional</rename><update>Y</update></value>
    </lookup>
    <attributes/>
    <cluster_schema/>
    <remotesteps><input></input><output></output></remotesteps>
    <GUI><xloc>440</xloc><yloc>120</yloc><draw>Y</draw></GUI>
  </step>
  <step_error_handling>
  </step_error_handling>
  <slave-step-copy-partition-distribution>
  </slave-step-copy-partition-distribution>
  <slave_transformation>N</slave_transformation>
</transformation>
