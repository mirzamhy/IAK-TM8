  <connection>
    <name>sqlite_manufaktur</name>
    <server/>
    <type>SQLITE</type>
    <access>Native</access>
    <database>${Internal.Transformation.Filename.Directory}/data/manufaktur_pentaho.sqlite</database>
    <port>-1</port>
    <username/>
    <password>Encrypted </password>
    <servername/>
    <data_tablespace/>
    <index_tablespace/>
    <attributes>
      <attribute><code>FORCE_IDENTIFIERS_TO_LOWERCASE</code><attribute>N</attribute></attribute>
      <attribute><code>FORCE_IDENTIFIERS_TO_UPPERCASE</code><attribute>N</attribute></attribute>
      <attribute><code>IS_CLUSTERED</code><attribute>N</attribute></attribute>
      <attribute><code>PORT_NUMBER</code><attribute>-1</attribute></attribute>
      <attribute><code>QUOTE_ALL_FIELDS</code><attribute>N</attribute></attribute>
      <attribute><code>SUPPORTS_BOOLEAN_DATA_TYPE</code><attribute>N</attribute></attribute>
      <attribute><code>USE_POOLING</code><attribute>N</attribute></attribute>
    </attributes>
  </connection>

  <notepads>
    <notepad>
      <note>LEVEL 3 - INTEGRATED (sinkronisasi)
Merge rows (diff) membandingkan fakta lama dengan staging per kunci (kode_wilayah_bps, tahun, skala):
  new -&gt; INSERT, changed -&gt; UPDATE, identical -&gt; dilewati
Setiap INSERT/UPDATE dicatat di etl_changes. Menjalankan ulang ETL tidak menggandakan data.</note>
      <xloc>60</xloc><yloc>480</yloc><width>640</width><heigth>70</heigth>
      <fontname/><fontsize>-1</fontsize><fontbold>N</fontbold><fontitalic>N</fontitalic>
      <fontcolorred>0</fontcolorred><fontcolorgreen>0</fontcolorgreen><fontcolorblue>0</fontcolorblue>
      <backgroundcolorred>210</backgroundcolorred><backgroundcolorgreen>245</backgroundcolorgreen><backgroundcolorblue>210</backgroundcolorblue>
      <bordercolorred>100</bordercolorred><bordercolorgreen>100</bordercolorgreen><bordercolorblue>100</bordercolorblue>
      <drawshadow>N</drawshadow>
    </notepad>
  </notepads>
  <order>
    <hop><from>Fakta lama (referensi)</from><to>Bandingkan (merge rows diff)</to><enabled>Y</enabled></hop>
    <hop><from>Staging baru (pembanding)</from><to>Bandingkan (merge rows diff)</to><enabled>Y</enabled></hop>
    <hop><from>Bandingkan (merge rows diff)</from><to>Hash baris (MD5)</to><enabled>Y</enabled></hop>
    <hop><from>Hash baris (MD5)</from><to>RUN_ID</to><enabled>Y</enabled></hop>
    <hop><from>RUN_ID</from><to>Baris baru?</to><enabled>Y</enabled></hop>
    <hop><from>RUN_ID</from><to>Perlu dicatat?</to><enabled>Y</enabled></hop>
    <hop><from>Baris baru?</from><to>INSERT fakta baru</to><enabled>Y</enabled></hop>
    <hop><from>Baris baru?</from><to>Baris berubah?</to><enabled>Y</enabled></hop>
    <hop><from>Baris berubah?</from><to>UPDATE fakta berubah</to><enabled>Y</enabled></hop>
    <hop><from>Baris berubah?</from><to>Tetap (identical/deleted)</to><enabled>Y</enabled></hop>
    <hop><from>Perlu dicatat?</from><to>Jenis aksi</to><enabled>Y</enabled></hop>
    <hop><from>Perlu dicatat?</from><to>Tidak dicatat</to><enabled>Y</enabled></hop>
    <hop><from>Jenis aksi</from><to>Nilai baru (JSON)</to><enabled>Y</enabled></hop>
    <hop><from>Nilai baru (JSON)</from><to>etl_changes</to><enabled>Y</enabled></hop>
  </order>

  <step>
    <name>Fakta lama (referensi)</name>
    <type>TableInput</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning><method>none</method><schema_name/></partitioning>
    <connection>sqlite_manufaktur</connection>
    <sql>SELECT kode_wilayah_bps, tahun, skala, jumlah_perusahaan, tenaga_kerja, nilai_input_juta_rupiah, nilai_output_juta_rupiah, pengeluaran_tenaga_kerja_juta_rupiah
FROM fact_manufaktur
ORDER BY kode_wilayah_bps, tahun, skala</sql>
    <limit>0</limit>
    <lookup/>
    <execute_each_row>N</execute_each_row>
    <variables_active>Y</variables_active>
    <lazy_conversion_active>N</lazy_conversion_active>
    <attributes/>
    <cluster_schema/>
    <remotesteps><input></input><output></output></remotesteps>
    <GUI><xloc>80</xloc><yloc>80</yloc><draw>Y</draw></GUI>
  </step>
  <step>
    <name>Staging baru (pembanding)</name>
    <type>TableInput</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning><method>none</method><schema_name/></partitioning>
    <connection>sqlite_manufaktur</connection>
    <sql>SELECT kode_wilayah_bps, tahun, skala, jumlah_perusahaan, tenaga_kerja, nilai_input_juta_rupiah, nilai_output_juta_rupiah, pengeluaran_tenaga_kerja_juta_rupiah
FROM stg_manufaktur
WHERE run_id = '${RUN_ID}'
ORDER BY kode_wilayah_bps, tahun, skala</sql>
    <limit>0</limit>
    <lookup/>
    <execute_each_row>N</execute_each_row>
    <variables_active>Y</variables_active>
    <lazy_conversion_active>N</lazy_conversion_active>
    <attributes/>
    <cluster_schema/>
    <remotesteps><input></input><output></output></remotesteps>
    <GUI><xloc>80</xloc><yloc>240</yloc><draw>Y</draw></GUI>
  </step>
  <step>
    <name>Bandingkan (merge rows diff)</name>
    <type>MergeRows</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning><method>none</method><schema_name/></partitioning>
    <keys>
      <key>kode_wilayah_bps</key>
      <key>tahun</key>
      <key>skala</key>
    </keys>
    <values>
      <value>jumlah_perusahaan</value>
      <value>tenaga_kerja</value>
      <value>nilai_input_juta_rupiah</value>
      <value>nilai_output_juta_rupiah</value>
      <value>pengeluaran_tenaga_kerja_juta_rupiah</value>
    </values>
    <flag_field>status_sinkron</flag_field>
    <reference>Fakta lama (referensi)</reference>
    <compare>Staging baru (pembanding)</compare>
    <attributes/>
    <cluster_schema/>
    <remotesteps><input></input><output></output></remotesteps>
    <GUI><xloc>280</xloc><yloc>160</yloc><draw>Y</draw></GUI>
  </step>
  <step>
    <name>Hash baris (MD5)</name>
    <type>ScriptValueMod</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning><method>none</method><schema_name/></partitioning>
    <compatible>N</compatible>
    <optimizationLevel>9</optimizationLevel>
    <jsScripts>
      <jsScript>
        <jsScript_type>0</jsScript_type>
        <jsScript_name>Script 1</jsScript_name>
        <jsScript_script>var teks = [(jumlah_perusahaan == null ? '' : String(jumlah_perusahaan)), (tenaga_kerja == null ? '' : String(tenaga_kerja)), (nilai_input_juta_rupiah == null ? '' : String(nilai_input_juta_rupiah)), (nilai_output_juta_rupiah == null ? '' : String(nilai_output_juta_rupiah)), (pengeluaran_tenaga_kerja_juta_rupiah == null ? '' : String(pengeluaran_tenaga_kerja_juta_rupiah))].join('|');
var digest = java.security.MessageDigest.getInstance('MD5').digest(new java.lang.String(teks).getBytes('UTF-8'));
var row_hash = '';
for (var i = 0; i &lt; digest.length; i++) { var h = (digest[i] &amp; 0xff).toString(16); row_hash += (h.length &lt; 2 ? '0' : '') + h; }</jsScript_script>
      </jsScript>
    </jsScripts>
    <fields>
      <field><name>row_hash</name><rename>row_hash</rename><type>String</type>
        <length>-1</length><precision>-1</precision><replace>N</replace></field>
    </fields>
    <attributes/>
    <cluster_schema/>
    <remotesteps><input></input><output></output></remotesteps>
    <GUI><xloc>460</xloc><yloc>160</yloc><draw>Y</draw></GUI>
  </step>
  <step>
    <name>RUN_ID</name>
    <type>GetVariable</type>
    <description/>
    <distribute>N</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning><method>none</method><schema_name/></partitioning>
    <fields>
      <field>
        <name>created_run_id</name><variable>${RUN_ID}</variable><type>String</type>
        <format/><currency/><decimal/><group/><length>-1</length><precision>-1</precision><trim_type>none</trim_type>
      </field>
      <field>
        <name>updated_run_id</name><variable>${RUN_ID}</variable><type>String</type>
        <format/><currency/><decimal/><group/><length>-1</length><precision>-1</precision><trim_type>none</trim_type>
      </field>
    </fields>
    <attributes/>
    <cluster_schema/>
    <remotesteps><input></input><output></output></remotesteps>
    <GUI><xloc>640</xloc><yloc>160</yloc><draw>Y</draw></GUI>
  </step>
  <step>
    <name>Baris baru?</name>
    <type>FilterRows</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning><method>none</method><schema_name/></partitioning>
    <send_true_to>INSERT fakta baru</send_true_to>
    <send_false_to>Baris berubah?</send_false_to>
    <compare>
      <condition>
        <negated>N</negated>
        <leftvalue>status_sinkron</leftvalue>
        <function>=</function>
        <rightvalue/>
        <value><name>constant</name><type>String</type><text>new</text>
          <length>-1</length><precision>-1</precision><isnull>N</isnull><mask/></value>
      </condition>
    </compare>
    <attributes/>
    <cluster_schema/>
    <remotesteps><input></input><output></output></remotesteps>
    <GUI><xloc>820</xloc><yloc>80</yloc><draw>Y</draw></GUI>
  </step>
  <step>
    <name>INSERT fakta baru</name>
    <type>TableOutput</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning><method>none</method><schema_name/></partitioning>
    <connection>sqlite_manufaktur</connection>
    <schema/>
    <table>fact_manufaktur</table>
    <commit>1000</commit>
    <truncate>N</truncate>
    <ignore_errors>N</ignore_errors>
    <use_batch>Y</use_batch>
    <specify_fields>Y</specify_fields>
    <partitioning_enabled>N</partitioning_enabled><partitioning_field/>
    <partitioning_daily>N</partitioning_daily><partitioning_monthly>Y</partitioning_monthly>
    <tablename_in_field>N</tablename_in_field><tablename_field/><tablename_in_table>Y</tablename_in_table>
    <return_keys>N</return_keys><return_field/>
    <fields>
      <field><column_name>kode_wilayah_bps</column_name><stream_name>kode_wilayah_bps</stream_name></field>
