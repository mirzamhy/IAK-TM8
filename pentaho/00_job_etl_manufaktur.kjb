    <entry>
      <name>Catat etl_runs</name>
      <description/>
      <type>SQL</type>
      <attributes/>
      <sql>INSERT INTO etl_runs(run_id, started_at, finished_at, inserted_rows, updated_rows, unchanged_rows, source_manifest_json)
SELECT '${RUN_ID}', '${RUN_STARTED}', datetime('now','localtime'), ins, upd,
       (SELECT COUNT(*) FROM stg_manufaktur WHERE run_id='${RUN_ID}') - ins - upd,
       (SELECT '[' || group_concat('{"file":"' || replace(nama_file,'\','/') || '","format":"' || format_sumber || '","baris":' || n || '}', ',') || ']'
          FROM (SELECT nama_file, format_sumber, COUNT(*) AS n FROM raw_manufaktur WHERE run_id='${RUN_ID}' GROUP BY nama_file, format_sumber))
FROM (SELECT (SELECT COUNT(*) FROM etl_changes WHERE run_id='${RUN_ID}' AND action='INSERT') AS ins,
             (SELECT COUNT(*) FROM etl_changes WHERE run_id='${RUN_ID}' AND action='UPDATE') AS upd);
</sql>
