  <connection>
    <name>sqlite_manufaktur</name>
    <server/>
    <type>SQLITE</type>
    <access>Native</access>
    <database>${Internal.Transformation.Filename.Directory}/data/manufaktur_pentaho.sqlite</database>
    <port>-1</port>
    <username/>
    <password>Encrypted </password>
    <servername/>
    <data_tablespace/>
    <index_tablespace/>
    <attributes>
      <attribute><code>FORCE_IDENTIFIERS_TO_LOWERCASE</code><attribute>N</attribute></attribute>
      <attribute><code>FORCE_IDENTIFIERS_TO_UPPERCASE</code><attribute>N</attribute></attribute>
      <attribute><code>IS_CLUSTERED</code><attribute>N</attribute></attribute>
      <attribute><code>PORT_NUMBER</code><attribute>-1</attribute></attribute>
      <attribute><code>QUOTE_ALL_FIELDS</code><attribute>N</attribute></attribute>
      <attribute><code>SUPPORTS_BOOLEAN_DATA_TYPE</code><attribute>N</attribute></attribute>
      <attribute><code>USE_POOLING</code><attribute>N</attribute></attribute>
    </attributes>
  </connection>

  <notepads>
    <notepad>
      <note>LEVEL 2 - STAGING (transformasi)
1. Nama provinsi dinormalisasi lalu dicocokkan ke kode BPS (wilayah.json)
2. Kolom Mikro/Kecil diubah menjadi baris (atribut skala)
3. "-" menjadi NULL, titik ribuan dihapus, teks diubah ke Integer
4. Duplikat identik disisihkan dan dicatat; nilai berbeda pada kunci sama = ETL dihentikan
5. Lima indikator dipivot menjadi satu baris per wilayah-tahun-skala</note>
      <xloc>60</xloc><yloc>600</yloc><width>620</width><heigth>100</heigth>
      <fontname/><fontsize>-1</fontsize><fontbold>N</fontbold><fontitalic>N</fontitalic>
      <fontcolorred>0</fontcolorred><fontcolorgreen>0</fontcolorgreen><fontcolorblue>0</fontcolorblue>
      <backgroundcolorred>255</backgroundcolorred><backgroundcolorgreen>240</backgroundcolorgreen><backgroundcolorblue>200</backgroundcolorblue>
      <bordercolorred>100</bordercolorred><bordercolorgreen>100</bordercolorgreen><bordercolorblue>100</bordercolorblue>
      <drawshadow>N</drawshadow>
    </notepad>
  </notepads>
  <order>
    <hop><from>Baca raw (RUN_ID ini)</from><to>Normalisasi nama provinsi</to><enabled>Y</enabled></hop>
    <hop><from>Normalisasi nama provinsi</from><to>Cocokkan kode BPS</to><enabled>Y</enabled></hop>
    <hop><from>Referensi wilayah (wilayah.json)</from><to>Normalisasi nama referensi</to><enabled>Y</enabled></hop>
    <hop><from>Normalisasi nama referensi</from><to>Cocokkan kode BPS</to><enabled>Y</enabled></hop>
    <hop><from>Cocokkan kode BPS</from><to>Kode wilayah ditemukan?</to><enabled>Y</enabled></hop>
    <hop><from>Kode wilayah ditemukan?</from><to>Unpivot Mikro/Kecil</to><enabled>Y</enabled></hop>
    <hop><from>Kode wilayah ditemukan?</from><to>Log wilayah tak dikenal</to><enabled>Y</enabled></hop>
    <hop><from>Unpivot Mikro/Kecil</from><to>Bersihkan angka</to><enabled>Y</enabled></hop>
    <hop><from>Bersihkan angka</from><to>Nama indikator</to><enabled>Y</enabled></hop>
    <hop><from>Nama indikator</from><to>Pilih kolom + tipe data</to><enabled>Y</enabled></hop>
    <hop><from>Pilih kolom + tipe data</from><to>Urutkan kunci</to><enabled>Y</enabled></hop>
    <hop><from>Urutkan kunci</from><to>Deduplikasi baris identik</to><enabled>Y</enabled></hop>
    <hop><from>Deduplikasi baris identik</from><to>Ada duplikat?</to><enabled>Y</enabled></hop>
    <hop><from>Deduplikasi baris identik</from><to>Hitung nilai per kunci</to><enabled>Y</enabled></hop>
    <hop><from>Deduplikasi baris identik</from><to>Pivot 5 indikator</to><enabled>Y</enabled></hop>
    <hop><from>Ada duplikat?</from><to>Log duplikat</to><enabled>Y</enabled></hop>
    <hop><from>Ada duplikat?</from><to>Abaikan (bukan duplikat)</to><enabled>Y</enabled></hop>
    <hop><from>Hitung nilai per kunci</from><to>Konflik nilai?</to><enabled>Y</enabled></hop>
    <hop><from>Konflik nilai?</from><to>STOP: konflik nilai</to><enabled>Y</enabled></hop>
    <hop><from>Konflik nilai?</from><to>Aman (tanpa konflik)</to><enabled>Y</enabled></hop>
    <hop><from>Pivot 5 indikator</from><to>RUN_ID</to><enabled>Y</enabled></hop>
    <hop><from>RUN_ID</from><to>stg_manufaktur</to><enabled>Y</enabled></hop>
    <hop><from>RUN_ID</from><to>Ekspor staging CSV</to><enabled>Y</enabled></hop>
  </order>

  <step>
    <name>Baca raw (RUN_ID ini)</name>
    <type>TableInput</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning><method>none</method><schema_name/></partitioning>
    <connection>sqlite_manufaktur</connection>
    <sql>SELECT dataset_id, tahun, provinsi, nilai_mikro, nilai_kecil, format_sumber
FROM raw_manufaktur WHERE run_id = '${RUN_ID}'</sql>
    <limit>0</limit>
    <lookup/>
    <execute_each_row>N</execute_each_row>
    <variables_active>Y</variables_active>
    <lazy_conversion_active>N</lazy_conversion_active>
    <attributes/>
    <cluster_schema/>
    <remotesteps><input></input><output></output></remotesteps>
    <GUI><xloc>60</xloc><yloc>120</yloc><draw>Y</draw></GUI>
  </step>
  <step>
    <name>Normalisasi nama provinsi</name>
    <type>ScriptValueMod</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning><method>none</method><schema_name/></partitioning>
    <compatible>N</compatible>
    <optimizationLevel>9</optimizationLevel>
    <jsScripts>
      <jsScript>
        <jsScript_type>0</jsScript_type>
        <jsScript_name>Script 1</jsScript_name>
        <jsScript_script>var provinsi_norm = (provinsi == null) ? null :
  String(provinsi).toUpperCase().replace(/[^A-Z0-9]+/g, ' ').replace(/^\s+|\s+$/g, '');</jsScript_script>
      </jsScript>
    </jsScripts>
    <fields>
      <field><name>provinsi_norm</name><rename>provinsi_norm</rename><type>String</type>
        <length>-1</length><precision>-1</precision><replace>N</replace></field>
    </fields>
    <attributes/>
    <cluster_schema/>
    <remotesteps><input></input><output></output></remotesteps>
    <GUI><xloc>230</xloc><yloc>120</yloc><draw>Y</draw></GUI>
  </step>
  <step>
    <name>Referensi wilayah (wilayah.json)</name>
    <type>JsonInput</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning><method>none</method><schema_name/></partitioning>
    <include>N</include>
    <include_field></include_field>
    <rownum>N</rownum>
    <addresultfile>N</addresultfile>
    <readurl>N</readurl>
    <removeSourceField>N</removeSourceField>
    <IsIgnoreEmptyFile>N</IsIgnoreEmptyFile>
    <doNotFailIfNoFile>N</doNotFailIfNoFile>
    <ignoreMissingPath>N</ignoreMissingPath>
    <defaultPathLeafToNull>Y</defaultPathLeafToNull>
    <rownum_field/>
    <file>
      <name>${Internal.Transformation.Filename.Directory}/../etl/config_2021_2025/wilayah.json</name>
      <filemask></filemask>
      <exclude_filemask/>
      <file_required>Y</file_required>
      <include_subfolders>N</include_subfolders>
    </file>
    <fields>
      <field>
        <name>kode</name>
        <path>$.regions[*].code</path>
        <type>String</type>
        <format/><currency/><decimal/><group/>
        <length>-1</length><precision>-1</precision>
        <trim_type>both</trim_type>
        <repeat>N</repeat>
      </field>
      <field>
        <name>nama</name>
        <path>$.regions[*].name</path>
        <type>String</type>
        <format/><currency/><decimal/><group/>
        <length>-1</length><precision>-1</precision>
        <trim_type>both</trim_type>
        <repeat>N</repeat>
      </field>
    </fields>
    <limit>0</limit>
    <IsInFields>N</IsInFields>
    <IsAFile>N</IsAFile>
    <valueField/>
    <shortFileFieldName/><pathFieldName/><hiddenFieldName/><lastModificationTimeFieldName/>
    <uriNameFieldName/><rootUriNameFieldName/><extensionFieldName/><sizeFieldName/>
    <attributes/>
    <cluster_schema/>
    <remotesteps><input></input><output></output></remotesteps>
    <GUI><xloc>230</xloc><yloc>260</yloc><draw>Y</draw></GUI>
  </step>
  <step>
    <name>Normalisasi nama referensi</name>
    <type>ScriptValueMod</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning><method>none</method><schema_name/></partitioning>
    <compatible>N</compatible>
    <optimizationLevel>9</optimizationLevel>
    <jsScripts>
      <jsScript>
        <jsScript_type>0</jsScript_type>
        <jsScript_name>Script 1</jsScript_name>
        <jsScript_script>var nama_norm = String(nama).toUpperCase().replace(/[^A-Z0-9]+/g, ' ').replace(/^\s+|\s+$/g, '');</jsScript_script>
      </jsScript>
    </jsScripts>
    <fields>
      <field><name>nama_norm</name><rename>nama_norm</rename><type>String</type>
        <length>-1</length><precision>-1</precision><replace>N</replace></field>
    </fields>
    <attributes/>
    <cluster_schema/>
    <remotesteps><input></input><output></output></remotesteps>
    <GUI><xloc>400</xloc><yloc>260</yloc><draw>Y</draw></GUI>
  </step>
  <step>
    <name>Cocokkan kode BPS</name>
    <type>StreamLookup</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning><method>none</method><schema_name/></partitioning>
    <from>Normalisasi nama referensi</from>
    <input_sorted>N</input_sorted>
    <preserve_memory>Y</preserve_memory>
    <sorted_list>N</sorted_list>
    <integer_pair>N</integer_pair>
    <lookup>
      <key><name>provinsi_norm</name><field>nama_norm</field></key>
      <value><name>kode</name><rename>kode_wilayah_bps</rename><default/><type>String</type></value>
    </lookup>
    <attributes/>
    <cluster_schema/>
    <remotesteps><input></input><output></output></remotesteps>
    <GUI><xloc>400</xloc><yloc>120</yloc><draw>Y</draw></GUI>
  </step>
  <step>
    <name>Kode wilayah ditemukan?</name>
    <type>FilterRows</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning><method>none</method><schema_name/></partitioning>
    <send_true_to>Unpivot Mikro/Kecil</send_true_to>
    <send_false_to>Log wilayah tak dikenal</send_false_to>
    <compare>
      <condition>
